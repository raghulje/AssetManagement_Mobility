# =============================================================================
# Refex IT Asset Management — server env (Biogas_MIS style)
# Copy to server/.env and set your port, public domain, and DB credentials.
# Never commit server/.env
# =============================================================================

# --- Server listen (pick a free port on the host / in Docker) ---
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# Production: Express serves built SPA from ../client/out on the same PORT
# Build first:  cd client && npm ci && npm run build
SERVE_CLIENT=true

# --- Public origin (no hardcoded LAN IPs) ---
# Set to the URL users open after you map domain → this service in the proxy.
# Examples:
#   https://itam.refex.group
#   http://localhost:3001          (local smoke test)
FRONTEND_URL=https://your-domain.com
PUBLIC_APP_URL=https://your-domain.com
# Comma-separated browser origins allowed for CORS (usually same as FRONTEND_URL)
CLIENT_ORIGIN=https://your-domain.com

# Only enable when TLS is terminated in front of the app (real HTTPS domain)
FORCE_HTTPS=false

# --- Database ---
# Local Node (host MySQL): DB_HOST=127.0.0.1  DB_PORT=3306
# Docker Compose app service overrides DB_HOST=db automatically.
# Compose publishes MySQL on host port MYSQL_PUBLISH_PORT (default 3307) for dump/import.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ITAssetManagement_2026
DB_USER=itam
DB_PASSWORD=itam_change_me

# Used by docker-compose MySQL service (+ root for admin)
MYSQL_ROOT_PASSWORD=itam_root_change_me
MYSQL_PUBLISH_PORT=3307

# --- Auth ---
JWT_SECRET=change_this_to_a_secure_random_string_in_production

# App Users allowed to log in (comma-separated emails)
ALLOWED_LOGIN_EMAILS=admin@refex.com

# Optional shared key for ITAgent register/sync
# AGENT_API_KEY=

# --- Adrenalin Live HRMS (employee sync) ---
ADRENALIN_BASE_URL=https://refex.myadrenalin.com/JASON_DYNAMIC_API/SHERISHA/V1/JasonBase
ADRENALIN_USERNAME=
ADRENALIN_PASSWORD=
ADRENALIN_COMPANY_ID=SHERISHA
ADRENALIN_SYNC_INTERVAL_MINUTES=0

# --- Email ---
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply

# EOL / warranty digest (minutes; 1440 = daily; 0 = disabled)
EOL_ALERT_INTERVAL_MINUTES=1440
