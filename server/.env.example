DB_HOST=localhost
DB_PORT=3306
DB_NAME=ITAssetManagement_2026
DB_USER=your_user
DB_PASSWORD=your_password
JWT_SECRET=change-me-in-production
PORT=3001
HOST=0.0.0.0

# Biogas_MIS_Vizag style — true = Express serves client/out on PORT (recommended for LAN)
# Build first: cd client && npm ci && npm run build
SERVE_CLIENT=true

# Same URL users open on Wi‑Fi (UI + API). Update IP when DHCP changes.
FRONTEND_URL=http://10.x.x.x:3001
PUBLIC_APP_URL=http://10.x.x.x:3001
CLIENT_ORIGIN=http://localhost:3001,http://10.x.x.x:3001,http://localhost:5173

# Only force HTTPS headers when behind real TLS (never for plain http://10.x.x.x LAN)
FORCE_HTTPS=false

# Only these App Users may log in (comma-separated emails)
ALLOWED_LOGIN_EMAILS=admin@refex.com,raghul.je@refex.co.in

# Adrenalin Live HRMS (employee auto-sync)
ADRENALIN_BASE_URL=https://refex.myadrenalin.com/JASON_DYNAMIC_API/SHERISHA/V1/JasonBase
ADRENALIN_USERNAME=
ADRENALIN_PASSWORD=
ADRENALIN_COMPANY_ID=SHERISHA
ADRENALIN_SYNC_INTERVAL_MINUTES=0

# Email / password reset
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply

# EOL / warranty digest email (minutes; 1440 = daily; 0 = disabled)
EOL_ALERT_INTERVAL_MINUTES=1440
