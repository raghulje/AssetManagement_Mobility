# =============================================================================
# Refex IT Asset Management — server env (Biogas_MIS style)
# Copy to server/.env and set your port, public domain, and DB credentials.
# Never commit server/.env
# =============================================================================

# --- Server listen (pick a free port on the host / in Docker) ---
PORT=3073
HOST=0.0.0.0
NODE_ENV=production

# Production: Express serves built SPA from ../client/out on the same PORT
# Build first:  cd client && npm ci && npm run build
SERVE_CLIENT=true

# --- Public origin (no hardcoded LAN IPs) ---
# Set to the URL users open after you map domain → this service in the proxy.
# Examples:
#   https://itam.refex.group
#   http://localhost:3073          (local smoke test)
# Public HTTPS URL users open in the browser (NO container port — proxy uses 443).
# Public HTTPS URL users open in the browser (NO container port — proxy uses 443).
# Good:  https://mobility.refexone.com
# Bad:   https://mobility.refexone.com:3073
FRONTEND_URL=https://mobility.refexone.com
PUBLIC_APP_URL=https://mobility.refexone.com
# Local Vite: use http://localhost:5173 (bare http://localhost hits port 80 and fails)
# CORS allow-list (comma-separated OK). QR + password-reset emails use PUBLIC_APP_URL.
CLIENT_ORIGIN=https://mobility.refexone.com

# Only enable when TLS is terminated in front of the app (real HTTPS domain)
FORCE_HTTPS=false

# --- Database ---
# Local / Docker: point DB_HOST at your MySQL host (reachable from the container).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ITAssetManagement_2026
DB_USER=itam
DB_PASSWORD=itam_change_me

# --- Auth ---
JWT_SECRET=change_this_to_a_secure_random_string_in_production

# Optional shared key for ITAgent register/sync
# AGENT_API_KEY=

# --- SAML SSO (RefexOne portal as IdP; this Mobility app is the SP) ---
# Paste these into the RefexOne / IdP SAML app registration (replace any old Kissflow values):
#   Entity ID / Audience : https://mobility.refexone.com/saml/sp
#   ACS URL              : https://mobility.refexone.com/api/v1/auth/saml/acs
#   Home URL             : https://mobility.refexone.com/
#   SLO URL              : https://mobility.refexone.com/api/v1/auth/saml/slo
#   Name ID Format       : urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress
SAML_ENABLED=false
SAML_BUTTON_LABEL=Refex Mobility SSO
# Explicit SP URLs (must match what you register in the IdP portal):
SAML_SP_ENTITY_ID=https://mobility.refexone.com/saml/sp
SAML_ACS_URL=https://mobility.refexone.com/api/v1/auth/saml/acs
SAML_SLO_URL=https://mobility.refexone.com/api/v1/auth/saml/slo
SAML_HOME_URL=https://mobility.refexone.com/
# From RefexOne IdP metadata (required when SAML_ENABLED=true):
# Issuer / entry from sample assertion:
#   https://refexone.com/api/saml/ad96f3e4-fb82-4b37-b031-0389072a1b9d
SAML_IDP_ENTRY_POINT=https://refexone.com/api/saml/ad96f3e4-fb82-4b37-b031-0389072a1b9d
SAML_IDP_ISSUER=https://refexone.com/api/saml/ad96f3e4-fb82-4b37-b031-0389072a1b9d
# Paste IdP X.509 (base64 body only, or full PEM). Do not commit real certs in shared docs if rotated often.
SAML_IDP_CERT=
# RefexOne IdP signs the Assertion only — leave response signing off:
SAML_WANT_RESPONSE_SIGNED=false
SAML_WANT_ASSERTIONS_SIGNED=true
# SAML_IDP_SLO_URL=
# SAML_AUTO_PROVISION=false


# --- Adrenalin Live HRMS (employee sync) ---
ADRENALIN_BASE_URL=https://refex.myadrenalin.com/JASON_DYNAMIC_API/SHERISHA/V1/JasonBase
ADRENALIN_USERNAME=
ADRENALIN_PASSWORD=
ADRENALIN_COMPANY_ID=SHERISHA
ADRENALIN_SYNC_INTERVAL_MINUTES=0

# --- Email ---
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply

# EOL / warranty digest (minutes; 1440 = daily; 0 = disabled)
EOL_ALERT_INTERVAL_MINUTES=1440

# --- Maps (optional) ---
# Leave unset to keep OpenStreetMap + Nominatim (free, no key).
# To match Google Maps place addresses (e.g. Refex Towers listing):
#   1. Google Cloud Console → enable billing
#   2. Enable APIs:
#        - Geocoding API
#        - Maps JavaScript API
#        - Maps Static API          (satellite pin on GPS photo stamp)
#        - Places API  (legacy Nearby/Details)
#        - Places API (New)  (recommended for Maps-style formattedAddress)
#   3. Paste key below and restart the server.
# GOOGLE_MAPS_API_KEY=
# Optional browser-only key (defaults to GOOGLE_MAPS_API_KEY):
# GOOGLE_MAPS_BROWSER_KEY=
